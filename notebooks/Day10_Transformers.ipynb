   "source": [
    "def build_vocab(docs):\n",
    "    vocab={}\n",
    "    for doc in docs:\n",
    "        for token in doc:\n",
    "            if token not in vocab:\n",
    "                vocab[token]=len(vocab)\n",
    "\n",
    "    return vocab"
   ]
  },
